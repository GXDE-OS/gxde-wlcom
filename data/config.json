{
    "theme": {
        "name": "builltin-light",
        "icon_theme_name": "ukui-icon-theme-default"
    },
    "outputs": {},
    "layouts": {},
    "Inputs": {},
    "Seats": {},
    "InputAction": {
        "keyboard": {
            "win:no": {
                "enable": true,
                "actiontype": "dbus",
                "bustype": "session",
                "service": "org.ukui.menu",
                "path": "\/org\/ukui\/menu",
                "interface": "org.ukui.menu",
                "method": "WinKeyResponse",
                "desc": "show ukui menu"
            }
        },
        "gesture": {
            "hold:touch:1:none": {
                "enable": true,
                "actiontype": "button",
                "button": "right",
                "desc": "simulate right key"
            },
            "swipe:touch:1:up:bottom": {
                "enable": true,
                "actiontype": "command",
                "command": "ukui-window-switch --show-workspace",
                "desc": "show multitaskView"
            },
            "hold:touchpad:3:none": {
                "enable": true,
                "actiontype": "dbus",
                "bustype": "session",
                "service": "com.ukui.search.service",
                "path": "\/",
                "interface": "org.ukui.search.service",
                "method": "showWindow",
                "desc": "global search"
            },
            "swipe:touchpad:3:down": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Super_L",
                "keys": "h",
                "desc": "show desktop"
            },
            "swipe:touchpad:3:up": {
                "enable": true,
                "actiontype": "command",
                "command": "ukui-window-switch --show-workspace",
                "desc": "show multitaskView"
            },
            "swipe:touchpad:3:left+right": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Alt_L",
                "keys": "Tab",
                "desc": "switch windows"
            },
            "hold:touchpad:4:none": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Super_L",
                "keys": "a",
                "desc": "show Siderbar"
            },
            "swipe:touchpad:4:left": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Control_L+Alt_L",
                "keys": "Left",
                "desc": "switch Left Workspace"
            },
            "swipe:touchpad:4:right": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Control_L+Alt_L",
                "keys": "Right",
                "desc": "switch Right Workspace"
            },
            "swipe:touch:4:down": {
                "enable": true,
                "actiontype": "dbus",
                "bustype": "session",
                "service": "com.ukui.search.service",
                "path": "\/",
                "interface": "org.ukui.search.service",
                "method": "showWindow",
                "desc": "global search"
            },
            "swipe:touch:4:left+right": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Alt_L",
                "keys": "Tab",
                "desc": "switch windows"
            }
        }
    },
    "plugins": {}
}
