{
    "theme": {
        "type": 0,
        "icon_theme_name": "ukui-icon-theme-default"
    },
    "outputs": {},
    "layouts": {},
    "Inputs": {},
    "Seats": {},
    "InputAction": {
        "keyboard": {
            "win:no": {
                "enable": true,
                "type": "WLCOM_WIN_MENU",
                "actiontype": "dbus",
                "bustype": "session",
                "service": "org.ukui.menu",
                "path": "\/org\/ukui\/menu",
                "interface": "org.ukui.menu",
                "method": "WinKeyResponse",
                "desc": "show ukui menu"
            }
        },
        "gesture": {
            "hold:touch:1:none": {
                "enable": true,
                "actiontype": "button",
                "button": "right",
                "desc": "simulate right key"
            },
            "swipe:touch:1:up:bottom": {
                "enable": true,
                "actiontype": "command",
                "command": "ukui-window-switch --show-workspace",
                "desc": "show multitaskView"
            },
            "hold:touchpad:3:none": {
                "enable": true,
                "actiontype": "dbus",
                "bustype": "session",
                "service": "com.ukui.search.service",
                "path": "\/",
                "interface": "org.ukui.search.service",
                "method": "mainWindowSwitch",
                "desc": "global search"
            },
            "swipe:touchpad:3:left+right:none:trigger": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Alt_L:press",
                "keys": "Tab",
                "desc": "trigger switch windows"
            },
            "swipe:touchpad:3:left+right:none:after:500:up": {
                "enable": true,
                "actiontype": "key",
                "keys": "Up",
                "desc": "switch up windows"
            },
            "swipe:touchpad:3:left+right:none:after:500:down": {
                "enable": true,
                "actiontype": "key",
                "keys": "Down",
                "desc": "switch down windows"
            },
            "swipe:touchpad:3:left+right:none:after:500:left": {
                "enable": true,
                "actiontype": "key",
                "keys": "Left",
                "desc": "switch left windows"
            },
            "swipe:touchpad:3:left+right:none:after:500:right": {
                "enable": true,
                "actiontype": "key",
                "keys": "Right",
                "desc": "switch right windows"
            },
            "swipe:touchpad:3:left+right:none:stop": {
                "enable": true,
                "actiontype": "key",
                "keys": "Alt_L:release",
                "desc": "stop switch windows"
            },
            "hold:touchpad:4:none": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Super_L",
                "keys": "a",
                "desc": "show Siderbar"
            },
            "swipe:touchpad:4:left": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Control_L+Alt_L",
                "keys": "Left",
                "desc": "switch Left Workspace"
            },
            "swipe:touchpad:4:right": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Control_L+Alt_L",
                "keys": "Right",
                "desc": "switch Right Workspace"
            },
            "swipe:touch:4:down": {
                "enable": true,
                "actiontype": "dbus",
                "bustype": "session",
                "service": "com.ukui.search.service",
                "path": "\/",
                "interface": "org.ukui.search.service",
                "method": "showWindow",
                "desc": "global search"
            },
            "swipe:touch:4:left+right:none:trigger": {
                "enable": true,
                "actiontype": "key",
                "modifiers": "Alt_L:press",
                "keys": "Tab",
                "desc": "trigger switch windows"
            },
            "swipe:touch:4:left+right:none:after:0.15:up": {
                "enable": true,
                "actiontype": "key",
                "keys": "Up",
                "desc": "switch up windows"
            },
            "swipe:touch:4:left+right:none:after:0.15:down": {
                "enable": true,
                "actiontype": "key",
                "keys": "Down",
                "desc": "switch down windows"
            },
            "swipe:touch:4:left+right:none:after:0.15:left": {
                "enable": true,
                "actiontype": "key",
                "keys": "Left",
                "desc": "switch left windows"
            },
            "swipe:touch:4:left+right:none:after:0.15:right": {
                "enable": true,
                "actiontype": "key",
                "keys": "Right",
                "desc": "switch right windows"
            },
            "swipe:touch:4:left+right:none:stop": {
                "enable": true,
                "actiontype": "key",
                "keys": "Alt_L:release",
                "desc": "stop switch windows"
            }
        }
    },
    "plugins": {}
}